# Versions used by the TAS lab. This is the only place they are set: lib/common.sh sources
# this file, and every setup script reads the values from there. Override any of them for a
# single run by exporting it first, e.g.  K8S_VERSION=v1.37.0 ./setup/setup.sh
# (use a version that has a kindest/node image)

# kind CLI the lab was tested with. setup/cluster.sh warns when the installed kind differs.
# A kind release only ships node images for the Kubernetes versions it supports, so raise
# this together with K8S_VERSION.
KIND_VERSION="${KIND_VERSION:-v0.32.0}"

# Kubernetes version of every node (control plane and workers).
K8S_VERSION="${K8S_VERSION:-v1.37.0}"
# Node image booted by kind; defaults to the kindest/node image for K8S_VERSION.
KIND_NODE_IMAGE="${KIND_NODE_IMAGE:-kindest/node:${K8S_VERSION}}"

# Kueue release installed by setup/kueue.sh.
KUEUE_VERSION="${KUEUE_VERSION:-v0.20.0}"

# LeaderWorkerSet release installed by setup/lws.sh (used by the Kueue spreading scenarios).
LWS_VERSION="${LWS_VERSION:-v0.11.1}"

# Chainsaw CLI installed by setup/chainsaw.sh (runs the declarative scenarios under scenarios/).
CHAINSAW_VERSION="${CHAINSAW_VERSION:-v0.2.15}"

# After a version bump, also re-check what is tied to these versions:
#   - the Workload/PodGroup API group version (the scheduling.k8s.io manifests in scenarios/0[1-4]*, setup/kind-config.yaml
#     runtimeConfig) and the feature gate names in setup/kind-config.yaml, which depend on
#     K8S_VERSION;
#   - the kueue.x-k8s.io API version in the Kueue manifests of scenarios/templates and scenarios/05-*..08-* and the Kueue feature
#     gate names in setup/kueue.sh, which depend on KUEUE_VERSION;
#   - the leaderworkerset.x-k8s.io API version in scenarios/templates/lws.yaml,
#     which depends on LWS_VERSION and must stay supported by KUEUE_VERSION.
