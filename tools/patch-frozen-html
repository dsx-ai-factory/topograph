"""Patch MDX-unsafe HTML patterns in frozen version markdown files.

Rewrites in-place:
  - <p><picture><source><img/></picture></p> → ![alt](src)
  - <p><img .../></p> → ![alt](src)
  - <a name="..."></a> → removed (Fern auto-generates heading anchors)

Usage: patch-frozen-html FILE...
"""

import re
import sys


def patch(path):
    text = open(path).read()
    original = text

    # <p><picture><source><img/></picture></p> → ![alt](src)
    text = re.sub(
        r'<p[^>]*>\s*<picture>\s*<source\b[^>]*/>\s*<img\s+src="([^"]+)"[^>]*\balt="([^"]*)"[^>]*/>\s*</picture>\s*</p>',
        r'![\2](\1)',
        text,
        flags=re.DOTALL,
    )

    # <p><img .../></p> → ![alt](src)
    text = re.sub(
        r'<p[^>]*>\s*<img\s+src="([^"]+)"[^>]*\balt="([^"]*)"[^>]*/>\s*</p>',
        r'![\2](\1)',
        text,
    )

    # <a name="..."></a> → removed
    text = re.sub(r'\s*<a\s+name="[^"]*">\s*</a>', '', text)

    if text != original:
        open(path, 'w').write(text)


if __name__ == "__main__":
    for arg in sys.argv[1:]:
        patch(arg)
