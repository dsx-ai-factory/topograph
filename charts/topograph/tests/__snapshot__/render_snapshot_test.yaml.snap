          volumes:
            - configMap:
                defaultMode: 420
                name: chart-ci-topograph-node-observer
              name: config-volume
  11: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: chart-ci-topograph-node-observer
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - list
          - watch
      - apiGroups:
          - apps
        resources:
          - daemonsets
        verbs:
          - list
          - watch
  12: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: chart-ci-topograph-node-observer
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
